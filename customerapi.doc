        "loanType": "Daily Loan",
        "amount": 20000,
        "dailyInstallment": 220,
        "daysPaid": 32,
        "daysTotal": 100,
        "status": "Approved"
      }
    ],
    "deposits": [
      {
        "accountId": "FD001",
