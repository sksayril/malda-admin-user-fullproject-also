      "pincode": "700017",
      "referralCode": "AGT-3601",
      "kycStatus": "Verified"
    },
    "loans": [
      {
        "loanId": "LN001",
        "customerName": "Md. Salim Ansari",
        "loanType": "Personal Loan",
        "amount": 50000,
        "monthlyEmi": 2350,
        "interestRate": 12,
